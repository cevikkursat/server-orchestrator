# Example settings for local development (all optional; the defaults suit local development)
PORT=3100
DATA_DIR=./data
NODE_ENV=development

# Suggested base domain for new projects (*.localhost locally)
BASE_DOMAIN=localhost

# Local Caddy (deploy/docker-compose.dev.yml)
CADDY_ADMIN=http://localhost:2019
CADDY_HTTPS=false

# The server's public IP for domain DNS checks (can stay empty locally)
# PUBLIC_IP=
