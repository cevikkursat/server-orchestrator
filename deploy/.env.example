# Copy to /opt/panel/src/deploy/.env

# The panel's Tailscale address (printed at the end of install.sh), e.g. panel.tailXXXX.ts.net
PANEL_DOMAIN=panel.tailXXXX.ts.net
# tailscale: panel closed to the internet (recommended); public: PANEL_DOMAIN open to the internet
PANEL_ACCESS=tailscale
# The single internet-facing address for GitHub push events (only the webhook path is open).
# Leave empty for no automatic deploys; deploys are then started from the panel.
WEBHOOK_DOMAIN=deploy.example.com

BASE_DOMAIN=example.com
ACME_EMAIL=you@example.com
# The host's public IP addresses (shown in your provider's console). Caddy opens 80/443 ONLY on
# these addresses (tailscaled uses 443 on its own addresses, so Caddy cannot listen on all of them).
# They must appear on a network interface of the host: ip -br addr
# WSL2 (mirrored networking): the Windows host's address on its LAN/public interface.
PUBLIC_IPV4=
# Leave empty if there is no IPv6
PUBLIC_IPV6=
# Optional: bind Caddy to a different local address than PUBLIC_IPV4/6 (e.g. WSL2 in NAT mode:
# the distro's eth0 address; install-windows.ps1 keeps it up to date). Unset: PUBLIC_IPV4/6 is used.
# Commented out so the panel does not report them as missing settings.
# BIND_IPV4=
# BIND_IPV6=
# The host's Tailscale addresses: tailscale ip -4 / tailscale ip -6
# Needed for domains set to "Tailscale only" (PR previews etc.)
TAILSCALE_IPV4=
TAILSCALE_IPV6=
